# Krishi Setu — environment variables (names/placeholders only; never commit real values)

# ------------------------------------------------------------------
# Supabase — the app currently keeps these browser-safe values inline
# because this is a static, no-build deployment:
#   frontend/LAST_GOV_API_GRAPHS_FINAL.html          → SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY
#   frontend/public-site/*/js/auth.js (CONFIG)       → supabaseUrl, supabaseAnonKey (same values)
# Only the ANON / publishable key is used in the browser. Never put
# the service-role key in frontend code.
# ------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Note: SUPABASE_PUBLISHABLE_KEY is the standard publishable/anon key (sometimes referred to as SUPABASE_ANON_KEY).

# data.gov.in API key for the government mandi-feed refresh edge function
# (backend/supabase/functions/refresh-gov-feed). Set as a Supabase secret
# named GOV_API_KEY, not in this file.
GOV_API_KEY=

# Supabase-managed (set automatically by Supabase for Edge Functions):
# SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY — configured in the Supabase
# dashboard, never committed.

# Optional: path to Chrome/Edge executable used by the headless integration
# tests in tests/ (defaults to the standard Chrome install location).
CHROME_PATH=